# Runtime configuration for the videoscroll API (the Go binary).
#
# Development: copy to `.env.server` in the repo root (gitignored); every
# `videoscroll` command reads it automatically.
# Production:  deploy/install.sh copies this to /etc/videoscroll.env (mode 640).
# Never commit a filled-in copy.

# ---------------------------------------------------------------- networking --
# Loopback only: Caddy terminates TLS and proxies to this. Do not bind 0.0.0.0
# on a machine with a forwarded port.
HOST=127.0.0.1
PORT=3000

# Exact origins allowed to call the API from a browser, comma-separated. This
# must include your GitHub Pages origin (scheme + host, no path).
ALLOWED_ORIGINS=https://osos3lom.github.io

# Only used to print invite links from the CLI.
APP_URL=https://osos3lom.github.io/videoscroll

# ------------------------------------------------------------------- storage --
# Root for videos/, posters/, meta/, incoming/, inbox/, failed/ and data/.
# Point this at the large disk.
MEDIA_DIR=/srv/videoscroll

# Uploads are refused (HTTP 507) if they would leave less free space than this.
MIN_FREE_BYTES=21474836480

# Largest single video accepted, in bytes. Uploads are chunked, so proxies
# never see more than 8 MiB per request regardless.
MAX_UPLOAD_BYTES=21474836480

# ---------------------------------------------------------------- processing --
# Videos are kept as-is. ffmpeg only rewrites containers, and fully re-encodes
# only codecs browsers cannot play. This caps software-encode threads so one
# core stays free for streaming.
FFMPEG_THREADS=3
TRANSCODE_TIMEOUT_MINUTES=360
# VAAPI_DEVICE=/dev/dri/renderD128

# ---------------------------------------------------------------------- auth --
# Optional. When unset, a random secret is generated once into
# $MEDIA_DIR/data/secret.key. Changing it signs everyone out.
# SESSION_SECRET=

# Honour X-Forwarded-For only from a loopback peer (Caddy). Set to "none" if
# nothing proxies in front of the server.
TRUST_PROXY=loopback
