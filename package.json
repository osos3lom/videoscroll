{
  "name": "videoscroll",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/server.mjs dev",
    "build": "npm run build:pages",
    "build:pages": "vite build --mode pages --base=/videoscroll/",
    "build:server": "node scripts/server.mjs build",
    "build:server:linux": "node scripts/server.mjs build --linux",
    "test:server": "node scripts/server.mjs test",
    "cli": "node scripts/server.mjs cli",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview:pages": "vite preview --base=/videoscroll/",
    "simulate": "node scripts/simulate.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
