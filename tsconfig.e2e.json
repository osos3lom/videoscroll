{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
    },
    "include": ["e2e", "playwright.config.ts", "scripts/simulate.d.mts", "src/types/api.ts"]
}
