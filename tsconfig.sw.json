{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "WebWorker"],
        "types": [],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo"
    },
    "include": ["src/sw", "src/lib/mediaCache/chunkStore.ts"]
}
