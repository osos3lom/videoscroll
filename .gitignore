# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# build output
/dist/
/dist-local/
/dist-server/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# server-side media + state (lives on the big disk in production)
/data/
/posters/

# server secrets (never commit)
.env.server

# local development media root (MEDIA_DIR default)
/media/

# local production simulation and e2e state
/.sim/
/.sim-e2e/
/test-results/
/playwright-report/
